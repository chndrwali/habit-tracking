# Salin ke .env.local untuk development, atau isi di Vercel > Settings > Environment Variables.
NEXT_PUBLIC_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=isi-dengan-string-acak-minimal-32-karakter
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Opsional, hanya untuk Google Calendar. Tanpa ini aplikasi tetap jalan penuh
# untuk habit/agenda/progres; halaman Kalender akan menampilkan "not_configured".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opsional, bawaan starter kit (tidak dipakai fitur habit v1).
RESEND_API_KEY=
UPLOADTHING_TOKEN=
