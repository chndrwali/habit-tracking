// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts    Account[]
  credentials Credential[]
  sessions    Session[]

  profile             UserProfile?
  habits              Habit[]
  scheduledItems      ScheduledItem[]
  calendarConnections CalendarConnection[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@map("user")
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  provider          String?   @default("credentials")
  providerAccountId String?
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  idToken           String?
  sessionState      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId             String
  providerId            String
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  password              String?

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("account")
}

model Credential {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  providerId String
  password   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("credential")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  token String

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
// ── Perencana Kebiasaan (PRD v1.0) ─────────────────────────────
// Identitas auth tetap milik Better Auth; profil tambahan dipisah.
// Completion disimpan pada occurrence (ScheduledItem), bukan hanya pada
// definisi habit (BR-02). Status: pending | completed | skipped | missed.
// syncStatus: not_synced | pending | synced | failed.

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  timezone        String   @default("Asia/Jakarta")
  weekStartsOn    Int      @default(1)
  timeFormat      String   @default("24")
  reminderMinutes Int      @default(15)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

model Habit {
  id                    String    @id @default(cuid())
  userId                String
  name                  String
  description           String?
  category              String?
  color                 String    @default("#0EA5A5")
  defaultDurationMinutes Int      @default(30)
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules HabitSchedule[]
  items     ScheduledItem[]

  @@index([userId])
  @@map("habit")
}

model HabitSchedule {
  id              String   @id @default(cuid())
  habitId         String
  daysOfWeek      Int[]
  localTime       String
  durationMinutes Int
  effectiveFrom   String?
  effectiveUntil  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  habit Habit           @relation(fields: [habitId], references: [id], onDelete: Cascade)
  items ScheduledItem[]

  @@index([habitId])
  @@map("habit_schedule")
}

model ScheduledItem {
  id          String    @id @default(cuid())
  userId      String
  habitId     String?
  scheduleId  String?
  title       String
  notes       String?
  dateKey     String
  startAt     DateTime
  endAt       DateTime
  timezone    String
  status      String    @default("pending")
  source      String    @default("habit")
  completedAt DateTime?
  syncStatus  String    @default("not_synced")
  syncError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit    Habit?            @relation(fields: [habitId], references: [id], onDelete: SetNull)
  schedule HabitSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  mappings CalendarEventMapping[]

  @@unique([userId, scheduleId, dateKey])
  @@index([userId, dateKey])
  @@index([userId, startAt])
  @@map("scheduled_item")
}

model CalendarConnection {
  id          String   @id @default(cuid())
  userId      String
  provider    String   @default("google")
  calendarId  String
  calendarName String?
  status      String   @default("connected")
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mappings CalendarEventMapping[]

  @@unique([userId, provider])
  @@map("calendar_connection")
}

model CalendarEventMapping {
  id                String    @id @default(cuid())
  connectionId      String
  scheduledItemId   String    @unique
  externalEventId   String
  externalCalendarId String
  syncStatus        String    @default("synced")
  lastSyncedAt      DateTime?
  error             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  connection    CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  scheduledItem ScheduledItem      @relation(fields: [scheduledItemId], references: [id], onDelete: Cascade)
  operations    SyncOperation[]

  @@map("calendar_event_mapping")
}

model SyncOperation {
  id         String    @id @default(cuid())
  mappingId  String?
  operation  String
  status     String    @default("pending")
  attempts   Int       @default(0)
  nextRetryAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  mapping CalendarEventMapping? @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@map("sync_operation")
}
